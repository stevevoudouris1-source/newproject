#!/usr/bin/env bash
#
# bin/ci — the full local quality gate. Must be green before every commit/push.
# Mirrors .github/workflows/ci.yml. Works in Git Bash (Windows) and bash/zsh (Mac).
set -euo pipefail
cd "$(dirname "$0")/.."

echo "== Ruff (lint)"
uv run ruff check .

echo "== Ruff (format check)"
uv run ruff format --check .

echo "== mypy (warnings only for now; blocking later — see pyproject.toml)"
uv run mypy . || true

echo "== Migration linter (first-party apps only; warnings fail too)"
uv run python manage.py lintmigrations --no-cache --warnings-as-errors \
  --exclude-apps auth admin contenttypes sessions django_q guardian

echo "== Migrations in sync with models?"
uv run python manage.py makemigrations --check --dry-run

echo "== pytest (parallel via pytest-xdist)"
uv run pytest -n auto

echo ""
echo "OK — all checks passed."
