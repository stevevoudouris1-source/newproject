# .env.example — copy to .env (gitignored) and fill in.
# THIS file is committed and must contain NO real secrets — keys + placeholders only.
# `bin/setup` copies it to .env automatically when .env is missing.

# --- Core -------------------------------------------------------------------
DEBUG=True
# Required in production. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=
ALLOWED_HOSTS=localhost,127.0.0.1

# --- Database mode ----------------------------------------------------------
# prototype = SQLite single file (default; zero setup; first-day prototyping)
# real      = SQL Server (fill DATABASE_URL; connection details come from Turn 5 IT)
MODE=prototype
# Only used when MODE=real. ODBC Driver 18 must be installed (see ai_context/setup.md).
# Shape:
#   mssql://USER:PASSWORD@SERVER:1433/DBNAME?driver=ODBC+Driver+18+for+SQL+Server&Encrypt=yes&TrustServerCertificate=no
DATABASE_URL=

# --- Optional: Azure data warehouse (read-only second connection) -----------
# Opt-in per app. Same URL shape as DATABASE_URL.
WAREHOUSE_DATABASE_URL=

# --- Standalone password login ----------------------------------------------
# Username/password sign-in for ordinary users (admins set passwords in the
# Users UI; users can change their own). On by default so the app has real auth
# before Entra SSO is configured — or instead of it. Set to false to force
# SSO-only. The Claude service account can always sign in regardless.
PASSWORD_LOGIN_ENABLED=true

# --- Microsoft Entra (Azure AD) SSO -----------------------------------------
# Leave blank to boot without SSO. Until SSO is set up, users sign in with the
# password login above (or the Claude service account). See
# .claude/skills/register-entra-app.md.
OIDC_TENANT_ID=
OIDC_RP_CLIENT_ID=
OIDC_RP_CLIENT_SECRET=

# --- Claude admin service account -------------------------------------------
CLAUDE_ADMIN_EMAIL=claude@turn5.local
# Set a strong value locally; rotate with `python manage.py rotate_claude_password`.
# NEVER commit a real value — this belongs only in .env / the prod secret store.
CLAUDE_ADMIN_PASSWORD=

# --- Network allowlist ------------------------------------------------------
# Which IPs may reach the app is controlled by the plain-text file
# allowed_ips.txt (default: allow all). Set this to true in production when the
# app sits behind a TRUSTED proxy, so the real client IP (X-Forwarded-For) is
# checked instead of the proxy's. Leave false for local dev.
IP_ALLOWLIST_TRUST_FORWARDED_FOR=false

# --- Email (production; provider still TBD) ---------------------------------
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
DEFAULT_FROM_EMAIL=no-reply@turn5.local
